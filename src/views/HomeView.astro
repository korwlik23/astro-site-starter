---
import type { CatalogEntries } from "../i18n/catalog-schema";

interface Props {
  marketing: CatalogEntries;
}

const { marketing } = Astro.props;
---

<div class="home-view">
  <section class="hero" aria-labelledby="hero-title">
    <p class="eyebrow">{marketing.eyebrow}</p>
    <h1 id="hero-title">{marketing.headline}</h1>
    <p class="hero-summary">{marketing.summary}</p>
    <a class="primary-action" href="#architecture">{marketing.primary_cta}</a>
  </section>

  <section id="features" class="section" aria-labelledby="features-title">
    <div class="section-heading">
      <p class="eyebrow">{marketing.features_eyebrow}</p>
      <h2 id="features-title">{marketing.features_title}</h2>
      <p>{marketing.features_summary}</p>
    </div>
    <div class="feature-grid">
      <article>
        <span aria-hidden="true">01</span>
        <h3>{marketing.feature_api_title}</h3>
        <p>{marketing.feature_api_body}</p>
      </article>
      <article>
        <span aria-hidden="true">02</span>
        <h3>{marketing.feature_admin_title}</h3>
        <p>{marketing.feature_admin_body}</p>
      </article>
      <article>
        <span aria-hidden="true">03</span>
        <h3>{marketing.feature_site_title}</h3>
        <p>{marketing.feature_site_body}</p>
      </article>
    </div>
  </section>

  <section id="architecture" class="section architecture" aria-labelledby="architecture-title">
    <div>
      <p class="eyebrow">{marketing.architecture_eyebrow}</p>
      <h2 id="architecture-title">{marketing.architecture_title}</h2>
    </div>
    <ol>
      <li><strong>{marketing.architecture_api_title}</strong><span>{marketing.architecture_api_body}</span></li>
      <li><strong>{marketing.architecture_admin_title}</strong><span>{marketing.architecture_admin_body}</span></li>
      <li><strong>{marketing.architecture_site_title}</strong><span>{marketing.architecture_site_body}</span></li>
    </ol>
  </section>

  <section id="faq" class="section faq" aria-labelledby="faq-title">
    <p class="eyebrow">{marketing.faq_eyebrow}</p>
    <h2 id="faq-title">{marketing.faq_title}</h2>
    <details open>
      <summary>{marketing.faq_language_question}</summary>
      <p>{marketing.faq_language_answer}</p>
    </details>
    <details>
      <summary>{marketing.faq_database_question}</summary>
      <p>{marketing.faq_database_answer}</p>
    </details>
  </section>
</div>
