---
import { APIRequestError, LocaleRegistryUnavailableError } from "../../../api/errors";
import { bundledCatalog } from "../../../i18n/load-catalog";
import { requireAvailableLocale, LocaleNotAvailableError } from "../../../i18n/availability";
import type { LocaleRegistry } from "../../../i18n/locale-registry";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import DocsView from "../../../views/DocsView.astro";
import { applyPublicCacheHeaders, normalizePublicPath, requestMatchesETag } from "../../../cms/route-utils";
import { getSiteRuntime } from "../../../runtime/site-runtime";
import { loadSiteConfig } from "../../../config/site";
import { buildPageMetadata } from "../../../seo/page-metadata";

export const prerender = false;

const runtime = getSiteRuntime();
let registry: LocaleRegistry | undefined;
let locale: Awaited<ReturnType<typeof requireAvailableLocale>> | undefined;
let content: Awaited<ReturnType<typeof loadDoc>> | undefined;
let errorMessage = "";
try {
  registry = await runtime.locales.get();
  locale = requireAvailableLocale(registry, Astro.params.locale ?? "");
  content = await loadDoc(locale.code, normalizePublicPath(Astro.params.slug));
  if (requestMatchesETag(Astro.request, content.etag) && content.etag !== undefined) {
    Astro.response.status = 304;
    Astro.response.headers.set("etag", content.etag);
  } else {
    applyPublicCacheHeaders(Astro.response, content.etag, content.loaded.stale);
  }
} catch (error) {
  if (error instanceof LocaleNotAvailableError || error instanceof APIRequestError && error.status === 404) {
    Astro.response.status = 404;
    errorMessage = "Not found";
  } else if (error instanceof LocaleRegistryUnavailableError || error instanceof APIRequestError && error.status >= 500) {
    Astro.response.status = 503;
    Astro.response.headers.set("cache-control", "no-store");
    errorMessage = "Service unavailable";
  } else {
    throw error;
  }
}

async function loadDoc(code: string, path: string) {
  const loaded = await runtime.content.get(code, path);
  return { loaded, etag: loaded.etag };
}
---

{content && locale && registry ? (
  <BaseLayout siteUrl={loadSiteConfig().public.siteUrl} locale={locale} registry={registry} common={bundledCatalog(locale.code, "common")} title={content.loaded.content.seo.title || content.loaded.content.title} description={content.loaded.content.seo.description || content.loaded.content.excerpt} metadata={buildPageMetadata({ siteUrl: loadSiteConfig().public.siteUrl, locale, registry, title: content.loaded.content.seo.title || content.loaded.content.title, description: content.loaded.content.seo.description || content.loaded.content.excerpt, content: content.loaded.content })}>
    <DocsView content={content.loaded.content} locale={locale} registry={registry} common={bundledCatalog(locale.code, "common")} />
  </BaseLayout>
) : <main><h1>{errorMessage}</h1></main>}
